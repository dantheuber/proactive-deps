{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true, // Generate .d.ts files
    "declarationMap": true // Optional: Generate .d.ts.map files for debugging
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
